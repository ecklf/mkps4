{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mkps4",
  "version": "0.1.0",
  "identifier": "dev.mkps4.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mkps4",
        "width": 1260,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "resources": {
      "../../../target/pkgtool/PkgTool.Core": "bin/PkgTool.Core"
    }
  }
}
